<query id="updateFileDownloadCount" action="update">
    <tables>
        <table name="archive_file" />
    </tables>
    <columns>
        <column name="download_count" var="download_count" filter="number" notnull="notnull" />
    </columns>
    <conditions>
        <condition operation="equal" column="file_srl" var="file_srl" notnull="notnull" />
    </conditions>
</query>
