<table name="archive_file">
	<column name="file_srl" type="number" notnull="notnull" primary_key="primary_key" />
	<column name="module_srl" type="number" notnull="notnull" index="idx_module_srl" />
	<column name="folder_srl" type="number" notnull="notnull" default="0" index="idx_folder_srl" />
	<column name="source_filename" type="varchar" size="250" notnull="notnull" />
	<column name="stored_filename" type="varchar" size="250" notnull="notnull" />
	<column name="filesize" type="number" notnull="notnull" default="0" />
	<column name="member_srl" type="number" notnull="notnull" />
	<column name="download_count" type="number" notnull="notnull" default="0" />
	<column name="regdate" type="varchar" size="14" notnull="notnull" />
</table>
