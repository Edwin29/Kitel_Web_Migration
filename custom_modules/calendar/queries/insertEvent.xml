<query id="insertEvent" action="insert">
    <tables>
        <table name="calendar_event" />
    </tables>
    <columns>
        <column name="event_srl" var="event_srl" filter="number" notnull="notnull" />
        <column name="module_srl" var="module_srl" filter="number" notnull="notnull" />
        <column name="title" var="title" notnull="notnull" />
        <column name="start_date" var="start_date" notnull="notnull" />
        <column name="end_date" var="end_date" notnull="notnull" />
        <column name="location" var="location" />
        <column name="category" var="category" />
        <column name="description" var="description" />
        <column name="member_srl" var="member_srl" filter="number" notnull="notnull" />
        <column name="regdate" var="regdate" default="curdate()" />
    </columns>
</query>
