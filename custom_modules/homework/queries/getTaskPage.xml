<query id="getTaskPage" action="select">
    <tables><table name="homework_task" /></tables>
    <columns><column name="*" /></columns>
    <conditions><condition operation="equal" column="module_srl" var="module_srl" notnull="notnull" /></conditions>
    <navigation>
        <index var="sort_index" default="task_srl" order="desc" />
        <list_count var="list_count" default="10" />
        <page_count var="page_count" default="5" />
        <page var="page" default="1" />
    </navigation>
</query>
