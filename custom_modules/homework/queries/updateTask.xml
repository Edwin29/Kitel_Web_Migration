<query id="updateTask" action="update">
    <tables>
        <table name="homework_task" />
    </tables>
    <columns>
        <column name="title" var="title" notnull="notnull" />
        <column name="description" var="description" />
        <column name="answer_fields" var="answer_fields" />
        <column name="allowed_extensions" var="allowed_extensions" />
        <column name="description_image" var="description_image" />
        <column name="deadline" var="deadline" />
    </columns>
    <conditions>
        <condition operation="equal" column="task_srl" var="task_srl" notnull="notnull" />
    </conditions>
</query>
